# =============================================================================
# Ascending PC — Docker Compose Environment Template
# Copy to .env at the repository root before running `docker compose up -d`:
#   cp .env.docker.example .env
# =============================================================================

# Gateway & Public URLs
APP_NAME=AscendingPC
APP_ENV=production
APP_DEBUG=false
APP_PORT=8080
APP_URL=http://localhost:8080
ASSET_URL=http://localhost:8080

# SvelteKit Build-Time Public URLs (baked into frontend bundle on build)
PUBLIC_API_URL=http://localhost:8080/api
PUBLIC_STORAGE_URL=http://localhost:8080

# Laravel Encryption Key (generate via: php artisan key:generate --show)
# Leave empty in local evaluation to auto-generate & persist inside backend_framework volume.
# Set REQUIRE_APP_KEY=true and supply a strong base64 key in production.
APP_KEY=
REQUIRE_APP_KEY=false
LOG_LEVEL=info

# PostgreSQL 16 Database
DB_DATABASE=ascending_pc
DB_USERNAME=ascending
DB_PASSWORD=change_me_in_production

# Startup Automation
RUN_MIGRATIONS=true
RUN_SEEDERS=false

# CORS (comma-separated browser origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_SUPPORTS_CREDENTIALS=false

# Midtrans Payment Gateway (Sandbox by default)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Prebuilt GHCR Images (used by compose.prod.yaml)
GHCR_OWNER=ascendingheat
IMAGE_TAG=latest
